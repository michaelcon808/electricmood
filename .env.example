# No secrets are needed anywhere in this project — every value here is public.
# Values are baked in at build time: change them in Netlify, then redeploy.

# Canonical site URL (no trailing slash). Used for canonicals, sitemap, RSS, Open Graph.
NEXT_PUBLIC_SITE_URL=https://electricmood.com

# true = every page gets <meta name="robots" content="noindex,nofollow">, robots.txt disallows all,
# and the sitemap is empty. Set to false at launch.
NEXT_PUBLIC_NOINDEX=true

# Lets content reference Cloudinary images by public ID (e.g. "electricmood/scooter-x1.jpg")
# instead of a full URL. Full res.cloudinary.com URLs always work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
